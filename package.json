{
  "name": "setkeeper",
  "version": "0.1.0",
  "description": "Pokémon TCG set tracker: on-device card scanning, fair-price checks, a smart buy planner and centering grades.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "build:artifact": "node build.mjs --artifact",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "fingerprints": "node scripts/precompute-fingerprints.ts",
    "eval:scanner": "node scripts/eval-scanner.ts 3",
    "eval:centering": "node scripts/eval-centering.ts",
    "scout": "node scripts/scout.ts",
    "grading-scout": "node scripts/grading-scout.ts",
    "gallery-scout": "node scripts/gallery-scout.ts",
    "sample-listings": "node scripts/make-sample-listings.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
